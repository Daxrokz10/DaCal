# Copy to .env and fill in. Never commit the real one.
#
# Generate the token with:   openssl rand -hex 32
PLATE_TOKEN=replace-me-with-64-random-hex-characters

# where state.json and backups/ live
PLATE_DATA=/opt/plate/server/data

# keep it on loopback — the Cloudflare Tunnel reaches it from the same machine
PLATE_HOST=127.0.0.1
PLATE_PORT=8787

# the exact origin your site is served from, no trailing slash
PLATE_ORIGINS=https://plate.daksh.site
