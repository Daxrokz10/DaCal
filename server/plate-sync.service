# Install:
#   sudo cp plate-sync.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now plate-sync
# Watch it:
#   journalctl -u plate-sync -f

[Unit]
Description=Plate & Platform sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# change this to your Ubuntu username
User=REPLACE_WITH_YOUR_USERNAME
Group=REPLACE_WITH_YOUR_USERNAME
WorkingDirectory=/opt/plate/server
EnvironmentFile=/opt/plate/server/.env
ExecStart=/usr/bin/node /opt/plate/server/server.js
Restart=always
RestartSec=3

# it only ever needs to read its own code and write its own data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/plate/server/data

[Install]
WantedBy=multi-user.target
